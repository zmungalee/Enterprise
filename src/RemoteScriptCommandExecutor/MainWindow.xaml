<Window x:Class="Enterprise.RemoteExecutor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Enterprise Remote Script &amp; Command Executor" Height="760" Width="1050" MinHeight="650" MinWidth="900" WindowStartupLocation="CenterScreen">
<Grid Margin="16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Remote Script &amp; Command Executor" FontSize="24" FontWeight="Bold" Margin="4"/>
<Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="4,10,4,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="Target computer" VerticalAlignment="Center"/><TextBox x:Name="TargetBox" Grid.Column="1"/><TextBlock x:Name="ConnectionStatus" Grid.Column="2" Text="Not tested" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid></Border>
<Grid Grid.Row="2" Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Administrator username" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="UsernameBox" Grid.Column="1"/><TextBlock Text="Password" Grid.Column="2" VerticalAlignment="Center" Margin="4"/><PasswordBox x:Name="PasswordBox" Grid.Column="3" Margin="4"/></Grid>
<Grid Grid.Row="3" Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Execution mode" VerticalAlignment="Center" Margin="4"/><ComboBox x:Name="ModeBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="ModeChanged" Margin="4"><ComboBoxItem Content="PowerShell Script (.ps1)"/><ComboBoxItem Content="Remote Elevated CMD"/></ComboBox><TextBlock Text="Timeout (seconds)" Grid.Column="2" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="TimeoutBox" Grid.Column="3" Text="300"/></Grid>
<StackPanel Grid.Row="4" x:Name="ScriptPanel"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PowerShell script" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="ScriptBox" Grid.Column="1"/><Button Grid.Column="2" Content="Browse..." Click="BrowseScript_Click"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Arguments" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="ArgumentsBox" Grid.Column="1"/></Grid><CheckBox x:Name="BypassBox" Content="Allow ExecutionPolicy Bypass for this execution (Advanced)" Margin="8,4"/>
</StackPanel>
<StackPanel Grid.Row="4" x:Name="CommandPanel" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CMD command" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="CommandBox" Grid.Column="1"/></Grid></StackPanel>
<StackPanel Grid.Row="5"><TextBlock Text="Output / audit" FontWeight="Bold" Margin="4,10,4,4"/><TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas"/></StackPanel>
<StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Test Connection" Click="TestConnection_Click"/><Button x:Name="ExecuteButton" Content="Execute" Click="Execute_Click" IsDefault="True"/><Button Content="Clear" Click="Clear_Click"/></StackPanel>
</Grid></Window>
